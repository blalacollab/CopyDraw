{
  "name": "copydraw",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' tests/*.test.js",
    "test:coverage:all": "node --test --experimental-test-coverage tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm test && npm run test:e2e"
  }
}
